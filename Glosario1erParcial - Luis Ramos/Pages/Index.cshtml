@page
@model IndexModel
@{
    ViewData["Title"] = "Glosario de Programación";
}

<div style="font-family: Arial, sans-serif; max-width: 900px; margin: 0 auto; text-align: center; padding: 40px 20px;">

    <h1 style="color: #333; margin-bottom: 10px; font-size: 2.5rem;">Glosario Técnico del 1er Parcial</h1>
    <p style="color: #666; font-size: 1.2rem; margin-bottom: 50px;">Selecciona el lenguaje a repasar.</p>


    <!-- Contenedor para alinear las tarjetas -->
    <div style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;">


        <!-- Tarjeta de HTML -->
        <a href="/HTML" style="text-decoration: none; color: inherit; width: 250px; border: 2px solid #e34c26; border-radius: 10px; padding: 25px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
            <h2 style="color: #e34c26; margin-top: 0; font-size: 2rem;">HTML</h2>
            <p style="color: #555; margin-bottom: 25px;">Etiquetas base de estructura, texto y creación de formularios.</p>
             <span style="display: inline-block; padding: 10px 20px; background-color: #e34c26; color: white; border-radius: 5px;">Ver HTML</span>
        </a>


        <!-- Tarjeta de CSS -->
        <a href="/Css" style="text-decoration: none; color: inherit; width: 250px; border: 2px solid #e34c26; border-radius: 10px; padding: 25px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
            <h2 style="color: #e34c26; margin-top: 0; font-size: 2rem;">CSS</h2>
            <p style="color: #555; margin-bottom: 25px;">Propiedades de diseño, alineación Flexbox y estilos visuales.</p>
             <span style="display: inline-block; padding: 10px 20px; background-color: #264de4; color: white; border-radius: 5px;">Ver CSS</span>
        </a>


        <!-- Tarjeta de C# -->
        <a href="/Csharp" style="text-decoration: none; color: inherit; width: 250px; border: 2px solid #e34c26; border-radius: 10px; padding: 25px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
            <h2 style="color: #e34c26; margin-top: 0; font-size: 2rem;">C#</h2>
            <p style="color: #555; margin-bottom: 25px;">Sintaxis, variables, clases, métodos y conceptos básicos de programación.</p>
             <span style="display: inline-block; padding: 10px 20px; background-color: #68217a; color: white; border-radius: 5px;">Ver C#</span>
        </a>

    </div>

</div>
